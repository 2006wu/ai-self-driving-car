FROM --platform=linux/amd64 ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Runtime-only image: X11, Qt, VNC/noVNC, and libraries needed by _ui.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    python3-pyqt5 \
    libqt5qml5 libqt5quickwidgets5 libqt5positioning5 \
    qtbase5-dev-tools mesa-utils openbox wmctrl \
    xvfb x11vnc novnc websockify \
    libzmq5 libcapnp-0.7.0 ocl-icd-libopencl1 \
    netcat-openbsd socat && \
    rm -rf /var/lib/apt/lists/*
COPY docker/display-entrypoint /usr/local/bin/display-entrypoint
COPY docker/display_client.py /usr/local/bin/display_client.py
COPY docker/launcher.py /usr/local/bin/launcher.py
RUN chmod +x /usr/local/bin/display-entrypoint
CMD ["/usr/local/bin/display-entrypoint"]
